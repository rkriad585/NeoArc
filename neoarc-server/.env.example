# NeoArc Server Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask secret key - generate a long random string
# Run: python -c "import secrets; print(secrets.token_hex(32))"
NEOARC_SECRET_KEY=

# Server binding
NEOARC_PORT=59248
NEOARC_HOST=0.0.0.0
NEOARC_DEBUG=False

# Admin credentials
NEOARC_ADMIN_EMAIL=admin@neoarc.local
NEOARC_ADMIN_PASSWORD=change_me

# Database path (relative to neoarc-server/)
NEOARC_DB_PATH=neoarc.db

# Upload settings
NEOARC_UPLOAD_FOLDER=static/uploads
NEOARC_MAX_UPLOAD_MB=5

# Admin route prefix
NEOARC_ADMIN_ROUTE=/admin

# API token for CLI authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# Build scripts inject this into the neoarc binary at compile time
NEOARC_API_TOKEN=

# SMTP for password reset emails (Gmail with App Password recommended)
# Generate an App Password at: https://myaccount.google.com/apppasswords
NEOARC_SMTP_HOST=smtp.gmail.com
NEOARC_SMTP_PORT=587
NEOARC_SMTP_USER=your.email@gmail.com
NEOARC_SMTP_PASSWORD=your-16-char-app-password
NEOARC_SMTP_FROM=your.email@gmail.com
