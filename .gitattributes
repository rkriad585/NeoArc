# Auto detect text files and perform LF normalization
* text=auto

# Go source files
*.go text diff=golang

# Python source files
*.py text diff=python

# Shell scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Documentation
*.md text diff=markdown

# Configuration files
*.toml text
*.json text
*.yaml text
*.yml text
*.env.example text

# Makefile
Makefile text
CMakeLists.txt text
Dockerfile text
.dockerignore text

# Build outputs
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text

# Lock and ignore files
.gitignore text
.gitattributes text
.dockerignore text

# Version file
.version text

# Go module files
go.sum text
go.work text

# GitHub Actions workflows
.github/** text
